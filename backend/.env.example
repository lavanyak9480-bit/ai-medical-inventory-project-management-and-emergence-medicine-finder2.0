# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=0
PORT=5000
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_64_CHAR_HEX_SECRET
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_64_CHAR_JWT_SECRET
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production Database URL (Optional - overrides MySQL/SQLite if set, e.g. PostgreSQL or MySQL)
# DATABASE_URL=postgresql://user:password@host:5432/medifind_db

# Database Configuration (MySQL)
DB_USER=root
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_HOST=localhost
DB_PORT=3306
DB_NAME=medifind_db
USE_SQLITE_FALLBACK=True

# Uploads Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760
